# dyld linker order file
# Controls symbol ordering and section inclusion for dyld executable
# Excludes __mod_init_func and __mod_term_func sections to prevent static initializers

# Entry point (must be first)
__dyld_start

# Core startup
dyldbootstrap::start
dyld::_main

# dyld2.cpp key functions (in rough execution order)
dyld::instantiateFromLoadedImage
dyld::runAllInitializers
dyld::processBindings
dyld::applyFixups
